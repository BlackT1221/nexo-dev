---
const links = [
  { name: "Inicio", href: "/#inicio" },
  { name: "Servicios", href: "/#servicios" },
  { name: "Contacto", href: "/#contacto" },
];
---

<footer class="w-full bg-white border-t border-gray-200">
  <div class="max-w-screen-xl mx-auto p-4 md:py-8">
    <div class="sm:flex sm:items-center sm:justify-between">
      <a href="#inicio" class="flex items-center gap-2.5 group select-none">
        <svg
          viewBox="0 0 200 200"
          class="w-9 h-9 transition-transform duration-300 group-hover:scale-105"
          xmlns="http://www.w3.org/2000/svg"
        >
          <style>
            .line-shadow {
              stroke: #c46902;
              stroke-width: 9;
              stroke-linecap: round;
              stroke-linejoin: round;
            }
            .line-front {
              stroke: #f58a07;
              stroke-width: 9;
              stroke-linecap: round;
              stroke-linejoin: round;
            }
            .diag-shadow {
              stroke: #c46902;
              stroke-width: 15;
              stroke-linecap: round;
              stroke-linejoin: round;
            }
            .diag-front {
              stroke: #f58a07;
              stroke-width: 15;
              stroke-linecap: round;
              stroke-linejoin: round;
            }
            .node-shadow {
              fill: #c46902;
            }
            .node-front {
              fill: #f58a07;
            }
          </style>

          <g transform="translate(6, 6)">
            <line x1="50" y1="45" x2="50" y2="155" class="line-shadow"></line>
            <line x1="150" y1="45" x2="150" y2="155" class="line-shadow"></line>
            <line x1="50" y1="45" x2="100" y2="100" class="diag-shadow"></line>
            <line x1="100" y1="100" x2="150" y2="155" class="diag-shadow"
            ></line>
            <circle cx="50" cy="45" r="11" class="node-shadow"></circle>
            <circle cx="50" cy="100" r="11" class="node-shadow"></circle>
            <circle cx="50" cy="155" r="11" class="node-shadow"></circle>
            <circle cx="100" cy="100" r="12" class="node-shadow"></circle>
            <circle cx="150" cy="45" r="11" class="node-shadow"></circle>
            <circle cx="150" cy="100" r="11" class="node-shadow"></circle>
            <circle cx="150" cy="155" r="11" class="node-shadow"></circle>
          </g>

          <g>
            <line x1="50" y1="45" x2="50" y2="155" class="line-front"></line>
            <line x1="150" y1="45" x2="150" y2="155" class="line-front"></line>
            <line x1="50" y1="45" x2="100" y2="100" class="diag-front"></line>
            <line x1="100" y1="100" x2="150" y2="155" class="diag-front"></line>
            <circle cx="50" cy="45" r="11" class="node-front"></circle>
            <circle cx="50" cy="100" r="11" class="node-front"></circle>
            <circle cx="50" cy="155" r="11" class="node-front"></circle>
            <circle cx="100" cy="100" r="12" class="node-front"></circle>
            <circle cx="150" cy="45" r="11" class="node-front"></circle>
            <circle cx="150" cy="100" r="11" class="node-front"></circle>
            <circle cx="150" cy="155" r="11" class="node-front"></circle>
          </g>
        </svg>

        <span class="text-xl font-black tracking-tight text-gray-900 font-sans">
          Nexo <span class="text-[#f58a07]">Dev</span>
        </span>
      </a>
      <ul
        class="flex flex-wrap items-center mb-6 text-sm font-medium text-gray-500 sm:mb-0"
      >
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="hover:underline me-4 md:me-6">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <hr class="my-6 border-gray-200 sm:mx-auto lg:my-8" />
    <span class="block text-sm text-gray-500 sm:text-center">
      © 2025 <a href="/" class="hover:underline hover:text-primary">Nexo Dev™</a
      >. Todos los derechos reservados.
    </span>
  </div>
</footer>
