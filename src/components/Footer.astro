---
const links = [
  { name: "Inicio", href: "/#inicio" },
  { name: "Servicios", href: "/#servicios" },
  { name: "Contacto", href: "/#contacto" },
];
---

<footer class="w-full bg-white border-t border-gray-200">
  <div class="max-w-screen-xl mx-auto p-4 md:py-8">
    <div class="sm:flex sm:items-center sm:justify-between">
      <a href="#inicio" class="flex items-center gap-2.5 group select-none">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          class="w-9 h-9 transition-transform duration-300 group-hover:scale-105"
        >
          <defs>
            <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#f58a07;stop-opacity:1"
              ></stop>
              <stop offset="100%" style="stop-color:#c46902;stop-opacity:1"
              ></stop>
            </linearGradient>
            <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="3"
              ></feGaussianBlur>
              <feOffset dx="2" dy="4" result="offsetblur"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.3"></feFlood>
              <feComposite in2="offsetblur" operator="in"></feComposite>
              <feMerge>
                <feMergeNode></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <circle cx="100" cy="100" r="90" fill="none" stroke="none"></circle>

          <g filter="url(#shadow)" transform="translate(10,10)">
            <path d="M40,40 L70,30 L70,160 L40,170 Z" fill="url(#grad1)"></path>
            <path
              d="M70,30 L130,90 L130,110 L70,50 Z"
              fill="#b35f00"
              opacity="0.9"></path>
            <path d="M130,30 L160,40 L160,170 L130,160 Z" fill="url(#grad1)"
            ></path>

            <circle
              cx="55"
              cy="35"
              r="12"
              fill="#f58a07"
              stroke="#ffffff"
              stroke-width="2"></circle>
            <circle
              cx="145"
              cy="165"
              r="12"
              fill="#f58a07"
              stroke="#ffffff"
              stroke-width="2"></circle>
            <circle cx="100" cy="98" r="8" fill="#c46902"></circle>
          </g>
        </svg>

        <span class="text-xl font-black tracking-tight text-gray-900 font-sans">
          Nexo <span class="text-[#f58a07]">Dev</span>
        </span>
      </a>
      <ul
        class="flex flex-wrap items-center mb-6 text-sm font-medium text-gray-500 sm:mb-0"
      >
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="hover:underline me-4 md:me-6">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <hr class="my-6 border-gray-200 sm:mx-auto lg:my-8" />
    <span class="block text-sm text-gray-500 sm:text-center">
      © 2025 <a href="/" class="hover:underline hover:text-primary">Nexo Dev™</a
      >. Todos los derechos reservados.
    </span>
  </div>
</footer>
