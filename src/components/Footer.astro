---
const links = [
  { name: "Inicio", href: "/#inicio" },
  { name: "Servicios", href: "/#servicios" },
  { name: "Contacto", href: "/#contacto" },
];
---

<footer class="w-full bg-white border-t border-gray-200">
  <div class="max-w-screen-xl mx-auto p-4 md:py-8">
    <div class="sm:flex sm:items-center sm:justify-between">
      <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
        <span class="self-center text-2xl font-semibold whitespace-nowrap text-primary">
          Nexo Dev
        </span>
      </a>
      <ul class="flex flex-wrap items-center mb-6 text-sm font-medium text-gray-500 sm:mb-0">
        {links.map(link => (
          <li><a href={link.href} class="hover:underline me-4 md:me-6">{link.name}</a></li>
        ))}
      </ul>
    </div>
    <hr class="my-6 border-gray-200 sm:mx-auto lg:my-8" />
    <span class="block text-sm text-gray-500 sm:text-center">
      © 2025 <a href="/" class="hover:underline hover:text-primary">Nexo Dev™</a>. Todos los derechos reservados.
    </span>
  </div>
</footer>
